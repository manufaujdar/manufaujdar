---
import Layout from '../layouts/Layout.astro';
import { focusTags, projects, researchInterests, selectedResearch } from '../data/site';
---

<Layout title="Work and Research | Manu Faujdar" description="Projects, research workspaces, and research interests from Manu Faujdar across health technology, reliable AI, privacy, devices, and translational science.">
	<section class="section">
		<div class="shell">
			<div class="section-heading">
				<p class="section-kicker">Work</p>
				<h1>Projects, research, and the problems I keep returning to.</h1>
				<p>I work across open-source systems, private research workspaces, and early scientific concepts. The common thread is turning a difficult question into something that can be specified, tested, or made legible to the people who need to assess it.</p>
				<p>Projects here range from prototypes and research writing to software, tools, and early ideas for reimagining existing systems. My main field is healthcare, but I also enjoy technical problems involving cars, air pollution, astronomy, life sciences, and anything that rewards a new way of thinking.</p>
				<div class="text-link-row"><a class="text-link" href="#projects">Jump to projects</a><a class="text-link" href="#research">Jump to selected research</a></div>
			</div>
			<div class="work-grid" id="projects">
				<div class="work-projects">
					<div class="split">
						<div><p class="section-kicker">Projects</p></div>
						<div class="project-list">
							{projects.map((project) => <article class="project-row">
								<div class="project-status">{project.status}</div>
								<div><h2 class="project-title">{project.title}</h2><p class="project-copy">{project.copy}</p></div>
								{project.href && <a class="row-link" href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} repository (opens in a new tab)`}>Repository</a>}
							</article>)}
						</div>
					</div>
				</div>
				<aside class="interest-column" aria-labelledby="interest-heading">
					<p class="section-kicker">Questions I return to</p>
					<h2 id="interest-heading">Curiosity is part of the work.</h2>
					<p class="interest-intro">I like problems where the science is still moving and the technical design has to respect evidence, people, and limits.</p>
					<div class="interest-list">
						{researchInterests.map((interest) => <article class="interest-item" data-reveal>
							<p class="interest-label">{interest.label}</p>
							<h3>{interest.title}</h3>
							<p>{interest.copy}</p>
						</article>)}
					</div>
					<div class="focus-tags">
						<p class="section-kicker">Focus tags</p>
						<ul class="tag-list">
							{focusTags.map((tag) => <li>{tag}</li>)}
						</ul>
					</div>
				</aside>
			</div>
		</div>
	</section>

	<section class="section" id="research">
		<div class="shell split">
			<div><p class="section-kicker">Selected Clinical research</p></div>
			<div>
				<p class="section-intro">These clinical research questions show the kinds of problems I want to carry from patient experience to evidence, and eventually toward a useful system.</p>
				<ol class="research-list">
					{selectedResearch.map((title, index) => <li class="research-row" data-reveal>
						<span class="research-index">{String(index + 1).padStart(2, '0')}</span>
						<h2>{title}</h2>
					</li>)}
				</ol>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="shell split">
			<div><p class="section-kicker">From question to evidence</p></div>
			<div class="split-copy">
				<p>The through-line is a difficult question moving from clinical context to study design, prototype, or system evaluation. Publication can be one step in that path, helping the work travel toward the people who need the solution.</p>
				<div class="text-link-row"><a class="text-link" href="/my-experience">Read the context</a><a class="text-link" href="/contact">Contact</a></div>
			</div>
		</div>
	</section>
</Layout>
