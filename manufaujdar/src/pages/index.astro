---
import Layout from '../layouts/Layout.astro';
import { links, notes, proofPoints, projects } from '../data/site';

const featuredTitles = new Set(['AI Routing Gateway', 'AI Firewall', 'BioVOC', 'Clinical Feedback System']);
const featuredOrder = ['AI Routing Gateway', 'AI Firewall', 'BioVOC', 'Clinical Feedback System'];
const featuredProjects = featuredOrder.flatMap((title) => projects.filter((project) => featuredTitles.has(project.title) && project.title === title));
---

<Layout title="Manu Faujdar | Health technology, research, and reliable AI" description="Manu Faujdar works on difficult healthcare and technology problems, from reliable AI workflows to research systems people can use.">
	<section class="hero" id="home" data-hero>
		<div class="shell">
		<p class="kicker">Clinical researcher / founder / systems builder</p>
			<h1 class="hero-name" data-scroll-name><span class="hero-prefix">Dr.</span> <span class="hero-name-text">Manu Faujdar</span></h1>
			<div class="home-about">
				<p class="home-about-copy">My work grows out of years of experience in medical training, entrepreneurship, and technology. I move between non-invasive sensing, patient experience, privacy-aware AI, and research tools because the most interesting problems rarely stay in one field.</p>
				<a class="home-about-link" href="/my-experience">More about me <span aria-hidden="true">+</span></a>
			</div>
			<div class="hero-links">
				<a class="text-link" href="/my-research">Selected work</a>
				<a class="text-link" href="/notes">Working notes</a>
				<a class="text-link" href="/contact">Contact</a>
				<a class="text-link" href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
			</div>
		</div>
	</section>

	<section class="section" data-reveal>
		<div class="shell">
			<div class="split">
				<div><p class="section-kicker">What I pay attention to</p></div>
				<div class="proof-grid">
					{proofPoints.map((point, index) => <article class="proof-card" data-reveal>
						<p class="practice-index">0{index + 1}</p>
						<h2>{point.label}</h2>
						<p>{point.copy}</p>
					</article>)}
				</div>
			</div>
		</div>
	</section>

	<section class="section" id="work" data-reveal>
		<div class="shell">
			<div class="split">
				<div><p class="section-kicker">Selected work</p></div>
				<div>
					<div class="project-list">
						{featuredProjects.map((project) => <article class="project-row" data-reveal>
							<div class="project-status">{project.href ? 'Open source' : 'Private work'}</div>
							<div><h2 class="project-title">{project.title}</h2><p class="project-copy">{project.copy}</p></div>
							{project.href && <a class="row-link" href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} repository (opens in a new tab)`}>Repository</a>}
						</article>)}
					</div>
		<div class="text-link-row"><a class="text-link" href="/my-research">See all work and research</a></div>
				</div>
			</div>
		</div>
	</section>

	<section class="section" data-reveal>
		<div class="shell split">
			<div><p class="section-kicker">Working notes</p></div>
			<div class="notes-preview">
				<p class="section-intro">Questions I am using to connect clinical context, evidence, and reliable systems.</p>
				{notes.slice(0, 2).map((note) => <article class="note-row" data-reveal>
					<p class="note-label">{note.label}</p>
					<h2>{note.title}</h2>
					<p>{note.copy}</p>
				</article>)}
				<div class="text-link-row"><a class="text-link" href="/notes">See all working notes</a></div>
			</div>
		</div>
	</section>

	<section class="section alt" data-reveal>
		<div class="shell split">
			<div><p class="section-kicker">What makes a problem worth pursuing</p></div>
			<div class="split-copy">
				<p>I am most interested in the point where a clinical, technical, or social problem is still rough—where a sharper question, a testable workflow, or a well-built prototype can change what becomes possible next.</p>
				<p>The work I return to has real stakes, incomplete evidence, or a privacy boundary that deserves to be made visible.</p>
				<div class="text-link-row"><a class="text-link" href="/my-experience">Read the context</a><a class="text-link" href="/contact">Contact</a></div>
			</div>
		</div>
	</section>
</Layout>
