---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
	 title: string;
	 description: string;
	 eyebrow?: string;
}

const { title, description, eyebrow = 'Manu Faujdar' } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://www.manufaujdar.com').toString();
const socialImage = new URL('/pwa-512.png', 'https://www.manufaujdar.com').toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="author" content="Manu Faujdar" />
		<meta name="application-name" content="Manu Faujdar" />
		<meta name="color-scheme" content="dark light" />
		<meta name="mobile-web-app-capable" content="yes" />
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Manu Faujdar" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImage} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<meta name="theme-color" content="#070707" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500&display=swap" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="mask-icon" href="/favicon.svg" color="#070707" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<script is:inline>
			{
				document.documentElement.classList.add('js');
				const systemTheme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				let initialTheme = systemTheme;
				try {
					const savedTheme = window.localStorage.getItem('mf-theme');
					if (savedTheme === 'light' || savedTheme === 'dark') initialTheme = savedTheme;
				} catch {}
				document.documentElement.dataset.theme = initialTheme;
				document.querySelector('meta[name="theme-color"]')?.setAttribute('content', initialTheme === 'light' ? '#f5f5f1' : '#070707');
			}
		</script>
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteHeader />
		<main id="main-content">
			<slot />
		</main>
		<SiteFooter />
		<script is:inline>
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const revealItems = document.querySelectorAll('[data-reveal]');

			if (reduceMotion || !('IntersectionObserver' in window)) {
				revealItems.forEach((item) => item.classList.add('is-visible'));
			} else {
				const revealObserver = new IntersectionObserver((entries, observer) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					});
				}, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
				revealItems.forEach((item) => revealObserver.observe(item));
			}

			const hero = document.querySelector('[data-hero]');
			const heroName = document.querySelector('[data-scroll-name]');
			let scrollFrame = 0;

			const updateNameMotion = () => {
				if (!hero || !heroName || reduceMotion) return;
				const progress = Math.min(1, Math.max(0, window.scrollY / Math.max(1, hero.clientHeight * 0.65)));
				heroName.style.setProperty('--scroll-shift', `${progress * -18}px`);
				heroName.style.setProperty('--name-line', `${0.26 + progress * 0.74}`);
				scrollFrame = 0;
			};

			if (hero && heroName && !reduceMotion) {
				updateNameMotion();
				window.addEventListener('scroll', () => {
					if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateNameMotion);
				}, { passive: true });
			}
		</script>
	</body>
</html>
